---
import { SITE } from '../config/site';
---

<section id="how-it-works" class="bg-navy-800 scroll-mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-18 lg:py-20">

    <!-- Section heading -->
    <div class="max-w-2xl mb-12">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white mb-3">
        How It Works
      </h2>
      <p class="text-slate-300 text-base leading-relaxed">
        Getting your van secured is straightforward. Here's what to expect from first contact
        to job done — typically within one week.
      </p>
    </div>

    <!-- Steps -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-0 relative">

      <!-- Connecting line (desktop only) -->
      <div class="hidden md:block absolute top-10 left-[calc(16.67%+24px)] right-[calc(16.67%+24px)] h-0.5 bg-amber-500/30" aria-hidden="true"></div>

      <!-- Step 1 -->
      <div class="relative flex flex-col items-center md:items-start text-center md:text-left md:pr-8">
        <div class="relative z-10 w-14 h-14 bg-amber-500 text-navy-900 rounded-full flex items-center justify-center font-extrabold text-lg mb-5 shadow-lg shrink-0">
          1
        </div>
        <div>
          <h3 class="text-white font-bold text-lg mb-2">Get in Touch</h3>
          <p class="text-slate-300 text-sm leading-relaxed mb-3">
            Call, WhatsApp, or fill in the quote form. We'll ask a few quick questions:
            your van make and model, which doors you need securing, and what lock type you're
            looking for (or we'll advise).
          </p>
          <p class="text-slate-400 text-sm leading-relaxed">
            We'll provide a clear, no-obligation quote — usually same day.
            Quotes are valid for <strong class="text-white">30 days</strong>.
          </p>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="relative flex flex-col items-center md:items-start text-center md:text-left md:px-4">
        <div class="relative z-10 w-14 h-14 bg-amber-500 text-navy-900 rounded-full flex items-center justify-center font-extrabold text-lg mb-5 shadow-lg shrink-0">
          2
        </div>
        <div>
          <h3 class="text-white font-bold text-lg mb-2">We Come to You</h3>
          <p class="text-slate-300 text-sm leading-relaxed mb-3">
            Once you're happy with the quote, we arrange a fitting time to suit you.
            We're fully mobile — we come to your home, workplace, or any convenient location
            within our service area.
          </p>
          <p class="text-slate-400 text-sm leading-relaxed">
            Most installations take 60–90 minutes. We aim for <strong class="text-white">within one week</strong>,
            often sooner if needed.
          </p>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="relative flex flex-col items-center md:items-start text-center md:text-left md:pl-8">
        <div class="relative z-10 w-14 h-14 bg-amber-500 text-navy-900 rounded-full flex items-center justify-center font-extrabold text-lg mb-5 shadow-lg shrink-0">
          3
        </div>
        <div>
          <h3 class="text-white font-bold text-lg mb-2">Drive Away Secure</h3>
          <p class="text-slate-300 text-sm leading-relaxed mb-3">
            Job done. We'll walk you through the new locks, show you how they operate, and
            answer any questions. Payment is by cash or bank transfer on completion —
            no deposit required.
          </p>
          <p class="text-slate-400 text-sm leading-relaxed">
            Your products carry a manufacturer's warranty.
            Any questions after the fit? We're easy to get hold of.
          </p>
        </div>
      </div>

    </div>

    <!-- Bottom CTA strip -->
    <div class="mt-12 pt-8 border-t border-navy-700 flex flex-col sm:flex-row items-center gap-4 justify-between">
      <p class="text-slate-300 text-sm text-center sm:text-left">
        Ready to secure your van? Get in touch today — we typically respond within a few hours.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 shrink-0">
        <a
          href={SITE.phone.href}
          class="flex items-center justify-center gap-2 bg-amber-500 hover:bg-amber-400 text-navy-900 font-bold text-sm px-5 py-3 rounded-lg transition-colors"
          aria-label={`Call ${SITE.phone.display}`}
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          Call Now
        </a>
        <a
          href="#contact"
          class="flex items-center justify-center gap-2 border border-amber-500 text-amber-400 hover:bg-amber-500/10 font-bold text-sm px-5 py-3 rounded-lg transition-colors"
        >
          Request a Quote
        </a>
      </div>
    </div>

  </div>
</section>
