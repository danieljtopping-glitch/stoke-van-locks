---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../config/site';
---

<Layout
  title="Quote Request Sent"
  description={`Thank you for contacting ${SITE.name}.`}
  noindex={true}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-24 sm:py-32 flex flex-col items-center justify-center text-center">
    
    <div class="w-20 h-20 bg-green-900/40 rounded-full flex items-center justify-center mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
      </svg>
    </div>

    <h1 class="font-display text-4xl sm:text-5xl font-extrabold text-white mb-6">
      Quote request sent!
    </h1>
    
    <p class="text-slate-300 text-lg leading-relaxed max-w-2xl mb-8">
      Thanks for getting in touch. I'll review your van details and be in touch as soon as possible - usually the same day. 
      In the meantime, feel free to call or WhatsApp me directly if your enquiry is urgent.
    </p>

    <div class="flex flex-col sm:flex-row gap-4">
      <a
        href="/"
        class="bg-zinc-800 hover:bg-zinc-700 text-white font-bold px-6 py-3 rounded-xl transition-all"
      >
        Return Home
      </a>
      <a
        href={SITE.phone.href}
        class="bg-gradient-to-br from-red-600 to-red-700 hover:from-red-500 hover:to-red-600 text-white font-bold px-6 py-3 rounded-xl transition-all shadow-lg shadow-red-600/30"
      >
        Call Me Now
      </a>
    </div>

  </div>
</Layout>
