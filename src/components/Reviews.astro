---
// Reviews / Testimonials section
// Placeholder reviews are clearly marked as examples.
// Replace with real customer reviews before launch.
// Consider pulling from Google Business Profile reviews.

const placeholderReviews = [
  {
    stars: 5,
    text: "Dan did a great job with my van locks they work perfectly and look the part! Very efficient and professional service. Highly recommended!",
    name: "Scott R",
    location: "Local Customer",
    note: "verified",
  },
  {
    stars: 5,
    text: "Very knowledgeable chap. He explained the difference between the lock types and helped me decide what was best for my van. Really pleased with the result.",
    name: "S. M.",
    location: "Stoke-on-Trent",
    note: "placeholder",
  },
  {
    stars: 5,
    text: "Sorted my fleet vehicles - six vans fitted in one day at my depot. Efficient, professional, and great value. Will be using again.",
    name: "R. T.",
    location: "Stafford",
    note: "placeholder",
  },
];
---

<section id="reviews" class="bg-zinc-950 scroll-mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-18 lg:py-20">

    <!-- Section heading -->
    <div class="max-w-2xl mb-10">
      <h2 class="font-display text-2xl sm:text-3xl font-extrabold text-white mb-3">
        What Customers Say
      </h2>
      <p class="text-zinc-300 text-base leading-relaxed">
        I take pride in the work I do and the service I deliver. Here's what some of my
        customers have said.
      </p>
    </div>

    <!-- Review cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
      {placeholderReviews.map((review) => (
        <div class="bg-black rounded-xl p-6 border border-zinc-800 shadow-sm flex flex-col">
          <!-- Stars -->
          <div class="flex gap-0.5 mb-3" aria-label={`${review.stars} out of 5 stars`}>
            {Array.from({ length: review.stars }).map(() => (
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-red-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>

          <!-- Review text -->
          <blockquote class="text-zinc-200 text-sm leading-relaxed mb-4 flex-1">
            "{review.text}"
          </blockquote>

          <!-- Reviewer -->
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 bg-navy-100 rounded-full flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-navy-800" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
            <div>
              <p class="text-white font-semibold text-sm">{review.name}</p>
              <p class="text-zinc-500 text-xs">{review.location}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- CTA to ask for references -->
    <div class="text-center">
      <p class="text-zinc-300 text-sm mb-4">
        Want to speak to a recent customer? Just ask - I'm happy to put you in touch with
        people who've had locks fitted.
      </p>
      <a
        href="#contact"
        class="inline-flex items-center gap-2 border border-zinc-700 text-zinc-200 hover:border-red-500 hover:text-red-500 font-semibold text-sm px-5 py-2.5 rounded-lg transition-colors"
      >
        Get in Touch
      </a>
    </div>

  </div>
</section>
