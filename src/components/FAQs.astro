---
import { FAQS } from '../config/site';
---

<section id="faqs" class="bg-white scroll-mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-18 lg:py-20">

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 lg:gap-16">

      <!-- Left column: heading + CTA -->
      <div class="lg:col-span-1">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mb-4">
          Frequently Asked Questions
        </h2>
        <p class="text-slate-600 text-sm leading-relaxed mb-6">
          Common questions about our van lock fitting service. Can't find what you're looking for?
          Just call or message us directly.
        </p>
        <a
          href="#contact"
          class="inline-flex items-center gap-2 bg-amber-500 hover:bg-amber-400 text-navy-900 font-bold text-sm px-5 py-3 rounded-lg transition-colors"
        >
          Ask a Question
        </a>
      </div>

      <!-- Right column: FAQ accordion -->
      <div class="lg:col-span-2">
        <dl class="divide-y divide-slate-200" id="faq-list">
          {FAQS.map((faq, index) => (
            <div class="py-4">
              <dt>
                <button
                  type="button"
                  class="faq-trigger w-full flex items-start justify-between gap-4 text-left text-slate-900 font-semibold text-sm sm:text-base hover:text-amber-600 transition-colors focus:outline-none focus:ring-2 focus:ring-amber-500 rounded py-1"
                  aria-expanded="false"
                  aria-controls={`faq-answer-${index}`}
                  id={`faq-trigger-${index}`}
                >
                  <span>{faq.question}</span>
                  <span class="faq-icon text-amber-500 font-bold text-xl leading-none shrink-0 mt-0.5" aria-hidden="true">+</span>
                </button>
              </dt>
              <dd
                id={`faq-answer-${index}`}
                role="region"
                aria-labelledby={`faq-trigger-${index}`}
                class="faq-answer hidden mt-3 pr-8"
              >
                <p class="text-slate-600 text-sm leading-relaxed">{faq.answer}</p>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>

  </div>
</section>

<script is:inline>
  (function () {
    document.querySelectorAll('.faq-trigger').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var answer = document.getElementById(btn.getAttribute('aria-controls'));
        var icon = btn.querySelector('.faq-icon');
        var isOpen = btn.getAttribute('aria-expanded') === 'true';

        // Close all
        document.querySelectorAll('.faq-trigger').forEach(function (otherBtn) {
          var otherId = otherBtn.getAttribute('aria-controls');
          var otherAnswer = document.getElementById(otherId);
          var otherIcon = otherBtn.querySelector('.faq-icon');
          otherBtn.setAttribute('aria-expanded', 'false');
          otherAnswer?.classList.add('hidden');
          if (otherIcon) otherIcon.textContent = '+';
        });

        // Open clicked if it was closed
        if (!isOpen && answer) {
          btn.setAttribute('aria-expanded', 'true');
          answer.classList.remove('hidden');
          if (icon) icon.textContent = '−';
        }
      });
    });
  })();
</script>
