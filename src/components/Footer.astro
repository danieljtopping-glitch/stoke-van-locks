---
import { SITE } from '../config/site';

const currentYear = new Date().getFullYear();

const quickLinks = [
  { label: 'Services', href: '#services' },
  { label: 'How It Works', href: '#how-it-works' },
  { label: 'Areas Covered', href: '#areas' },
  { label: 'Gallery', href: '#gallery' },
  { label: 'Reviews', href: '#reviews' },
  { label: 'FAQs', href: '#faqs' },
  { label: 'Get a Quote', href: '#contact' },
];

const legalLinks = [
  { label: 'Privacy Policy', href: '/privacy' },
  { label: 'Cookie Policy', href: '/cookies' },
];
---

<footer class="bg-navy-900 text-slate-300">
  <!-- Main footer content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 lg:gap-16">

      <!-- Column 1: Brand & Contact -->
      <div>
        <a href="/" class="inline-block mb-4 hover:opacity-90 transition-opacity">
          <img
            src="/images/logo.png"
            alt="Stoke Van Locks"
            class="h-14 w-auto rounded"
            loading="lazy"
          />
        </a>
        <p class="text-sm text-slate-400 mb-5 leading-relaxed">
          Mobile van lock fitting across Stoke-on-Trent and a 20-mile radius.
          Deadlocks, slam locks, hook locks — supplied and fitted by a specialist
          with 15–18 years of experience.
        </p>
        <p class="text-xs text-slate-500 mb-5 italic">
          Mobile service — no public shopfront.
        </p>

        <div class="flex flex-col gap-3">
          <a
            href={SITE.phone.href}
            class="flex items-center gap-2 text-sm text-white hover:text-amber-400 transition-colors font-medium"
            aria-label={`Call ${SITE.phone.display}`}
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            {SITE.phone.display}
          </a>
          <a
            href={SITE.whatsapp.href}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 text-sm text-green-400 hover:text-green-300 transition-colors font-medium"
            aria-label="Contact via WhatsApp"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            WhatsApp
          </a>
          <a
            href={`mailto:${SITE.email}`}
            class="flex items-center gap-2 text-sm text-slate-400 hover:text-white transition-colors"
            aria-label={`Email ${SITE.email}`}
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            {SITE.email}
          </a>
        </div>
      </div>

      <!-- Column 2: Quick Links -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-5">Quick Links</h3>
        <ul class="space-y-2">
          {quickLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-slate-400 hover:text-amber-400 transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-6 pt-6 border-t border-navy-700">
          <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-3">Legal</h3>
          <ul class="space-y-2">
            {legalLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-slate-400 hover:text-amber-400 transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Column 3: Service Area & CTA -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-5">Service Area</h3>
        <p class="text-sm text-slate-400 mb-4 leading-relaxed">
          We cover Stoke-on-Trent and approximately a 20-mile radius, including
          Newcastle-under-Lyme, Stafford, Crewe, Leek, Congleton, and surrounding areas.
        </p>
        <p class="text-xs text-slate-500 mb-6">
          Fitting is arranged to suit your schedule — appointments available to suit customer requirements.
        </p>

        <a
          href="#contact"
          class="inline-flex items-center justify-center gap-2 bg-amber-500 hover:bg-amber-400 text-navy-900 font-bold text-sm px-6 py-3 rounded transition-colors w-full sm:w-auto focus:outline-none focus:ring-2 focus:ring-amber-300"
        >
          Get a Free Quote
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>

        <p class="text-xs text-slate-500 mt-4">
          Quotes are valid for 30 days.
        </p>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-navy-700">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500">
      <p>
        &copy; {currentYear} {SITE.name}. All rights reserved. Stoke-on-Trent, Staffordshire.
      </p>
      <p>
        Quotes valid for 30 days &nbsp;·&nbsp;
        <a href="/privacy" class="hover:text-slate-300 transition-colors">Privacy Policy</a>
        &nbsp;·&nbsp;
        <a href="/cookies" class="hover:text-slate-300 transition-colors">Cookie Policy</a>
      </p>
    </div>
  </div>
</footer>
