---
import { AREAS, SITE } from '../config/site';
---

<section id="areas" class="bg-zinc-950 scroll-mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-18 lg:py-20">

    <!-- Section heading -->
    <div class="max-w-2xl mb-10">
      <h2 class="font-display text-2xl sm:text-3xl font-extrabold text-white mb-3">
        Areas I Cover
      </h2>
      <p class="text-zinc-300 text-base leading-relaxed">
        I'm based in Stoke-on-Trent and operate across approximately a 20-mile radius.
        I come to you - whether that's your home, workplace, or depot.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-start">

      <!-- Left: Area list -->
      <div>
        <p class="text-sm font-semibold text-zinc-400 uppercase tracking-wider mb-4">
          Examples within my range
        </p>
        <div class="grid grid-cols-2 gap-x-6 gap-y-2 mb-6">
          {AREAS.map((area) => (
            <div class="flex items-center gap-2 text-zinc-200 text-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-red-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              {area}
            </div>
          ))}
        </div>

        <!-- Radius note -->
        <div class="bg-zinc-900 border border-zinc-800 rounded-xl px-5 py-4 mb-6">
          <div class="flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <div>
              <p class="text-sm font-semibold text-red-100 mb-1">Just outside the radius?</p>
              <p class="text-sm text-red-200 leading-relaxed">
                Get in touch anyway - larger jobs and fleet work outside my usual range may
                be considered. I'll always be upfront about whether I can help.
              </p>
            </div>
          </div>
        </div>

        <!-- CTA -->
        <div class="flex flex-col sm:flex-row gap-3">
          <a
            href={SITE.phone.href}
            class="group flex items-center justify-center gap-2 bg-gradient-to-br from-red-600 to-red-700 hover:from-red-500 hover:to-red-600 text-white font-bold text-sm px-5 py-3 rounded-lg transition-all shadow-lg shadow-red-600/30 hover:shadow-red-600/50 hover:-translate-y-0.5"
            aria-label={`Call ${SITE.phone.display}`}
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            Request a Quote
          </a>
          <a
            href="#contact"
            class="group flex items-center justify-center gap-2 bg-gradient-to-br from-indigo-600 to-indigo-700 hover:from-indigo-500 hover:to-indigo-600 text-white font-bold text-sm px-5 py-3 rounded-lg transition-all shadow-lg shadow-indigo-600/30 hover:shadow-indigo-600/50 hover:-translate-y-0.5"
          >
            Request a Quote
          </a>
        </div>
      </div>

      <!-- Right: Map -->
      <div>
        <div class="bg-zinc-800 rounded-xl flex flex-col aspect-[4/3] border border-zinc-700 relative overflow-hidden">
          <div id="service-map" class="absolute inset-0 z-0"></div>
          
          <!-- Fallback/Overlay Text (hidden by JS when map loads) -->
          <div id="map-fallback" class="relative z-10 flex flex-col items-center justify-center h-full text-center px-6 pointer-events-none bg-zinc-900/80">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-red-500 mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <p class="text-zinc-200 font-semibold text-sm mb-1">Stoke-on-Trent (ST4 4QE)</p>
            <p class="text-zinc-400 text-xs">Loading interactive map...</p>
          </div>
        </div>
        <p class="text-xs text-zinc-500 mt-3 text-center">
          Service area is approximate. Contact me to confirm I cover your postcode.
        </p>
      </div>

    </div>
  </div>
</section>

<!-- Leaflet CSS & JS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<style>
  /* Ensure map tiles stack correctly under the nav */
  #service-map { z-index: 1; }
  /* Custom popup styling */
  .leaflet-popup-content-wrapper { background: #18181b; color: #f4f4f5; border: 1px solid #3f3f46; border-radius: 0.5rem; }
  .leaflet-popup-tip { background: #18181b; border: 1px solid #3f3f46; }
  .leaflet-popup-close-button { color: #a1a1aa !important; }
</style>

<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    // ST4 4QE Coordinates
    var centerLat = 52.979443;
    var centerLng = -2.194152;
    var radiusMiles = 20;
    var radiusMeters = radiusMiles * 1609.34;

    // Initialize Map
    var map = L.map('service-map', {
        scrollWheelZoom: false, // Prevent page scrolling from getting trapped
    }).setView([centerLat, centerLng], 9);

    // Hide fallback overlay now that JS runs
    var fallback = document.getElementById('map-fallback');
    if (fallback) fallback.style.display = 'none';

    // Add Carto Dark styling tiles (matches website aesthetic perfectly)
    L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
      maxZoom: 19,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>'
    }).addTo(map);

    // Add Marker for Base
    var marker = L.marker([centerLat, centerLng]).addTo(map);
    marker.bindPopup("<b>Stoke Van Locks</b><br>Mobile Service Base").openPopup();

    // Add 20-mile Radius Circle
    L.circle([centerLat, centerLng], {
      color: '#ef4444',      // Tailwind Red-500 border
      fillColor: '#ef4444',
      fillOpacity: 0.15,     // Light transparent fill
      weight: 2,             // Thin crisp border
    }).setRadius(radiusMeters).addTo(map);
  });
</script>
