---
import { SITE } from '../config/site';
---

<section id="contact" class="bg-navy-800 scroll-mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-18 lg:py-20">

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16">

      <!-- Left: Contact info -->
      <div>
        <h2 class="font-display text-2xl sm:text-3xl font-extrabold text-white mb-4">
          Get a Free Quote
        </h2>
        <p class="text-slate-300 text-base leading-relaxed mb-8">
          Ready to secure your van? Get in touch — I'll provide a clear, no-obligation quote.
          Most enquiries are responded to the same day.
        </p>

        <!-- Contact methods -->
        <div class="space-y-4 mb-8">
          <a
            href={SITE.phone.href}
            class="group flex items-center gap-4 bg-gradient-to-br from-red-600 to-red-700 hover:from-red-500 hover:to-red-600 text-white font-bold px-5 py-4 rounded-xl transition-all shadow-lg shadow-red-600/30 hover:shadow-red-600/50 hover:-translate-y-0.5"
            aria-label={`Call ${SITE.phone.display}`}
          >
            <div class="w-10 h-10 bg-navy-900/20 rounded-lg flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <p class="text-sm opacity-80">Call me (fastest)</p>
              <p class="text-lg font-extrabold">{SITE.phone.display}</p>
            </div>
          </a>

          <a
            href={SITE.whatsapp.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-4 bg-gradient-to-br from-emerald-500 to-emerald-600 hover:from-emerald-400 hover:to-emerald-500 text-white font-bold px-5 py-4 rounded-xl transition-all shadow-lg shadow-emerald-500/30 hover:shadow-emerald-500/50 hover:-translate-y-0.5"
            aria-label="Contact via WhatsApp"
          >
            <div class="w-10 h-10 bg-black/10 rounded-lg flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
            </div>
            <div>
              <p class="text-sm opacity-80">Message on WhatsApp</p>
              <p class="text-lg font-extrabold">WhatsApp Me</p>
            </div>
          </a>

          <a
            href={`mailto:${SITE.email}`}
            class="group flex items-center gap-4 bg-gradient-to-br from-blue-500 to-blue-600 hover:from-blue-400 hover:to-blue-500 text-white font-bold px-5 py-4 rounded-xl transition-all shadow-lg shadow-blue-500/30 hover:shadow-blue-500/50 hover:-translate-y-0.5"
            aria-label={`Email ${SITE.email}`}
          >
            <div class="w-10 h-10 bg-black/10 rounded-lg flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <p class="text-sm opacity-80">Message via Email</p>
              <p class="text-lg font-extrabold">Email Me</p>
            </div>
          </a>
        </div>

        <!-- Trust notes -->
        <div class="space-y-2 text-sm text-zinc-500">
          <p class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-red-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            No-obligation quotes — valid for 30 days
          </p>
          <p class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-red-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            Cash or bank transfer — no deposit required
          </p>
          <p class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-red-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            Fitting typically within one week
          </p>
          <p class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-red-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            Appointments to suit you — flexible scheduling
          </p>
        </div>
      </div>

      <!-- Right: Quote form -->
      <div>
        <!--
          NETLIFY FORMS SETUP
          This hidden form lets Netlify's build scanner detect the form.
          The visible form below is what users actually submit.
          Both must share the same `name` attribute.
        -->
        <form name="quote-request" netlify netlify-honeypot="bot-field" hidden>
          <input type="text" name="full-name" />
          <input type="tel" name="phone" />
          <input type="email" name="email" />
          <input type="text" name="postcode" />
          <input type="text" name="van-make" />
          <input type="text" name="van-model" />
          <input type="text" name="van-year" />
          <input type="text" name="doors" />
          <select name="lock-type">
            <option value="deadlock">Deadlock</option>
            <option value="slam-lock">Slam Lock</option>
            <option value="hook-lock">Hook Lock</option>
            <option value="not-sure">Not Sure</option>
          </select>
          <textarea name="notes"></textarea>
          <input type="checkbox" name="request-callback" />
          <select name="preferred-time">
            <option value="morning">Morning</option>
            <option value="afternoon">Afternoon</option>
            <option value="evening">Evening</option>
          </select>
        </form>

        <!-- Visible form -->
        <form
          name="quote-request"
          method="POST"
          data-netlify="true"
          data-netlify-honeypot="bot-field"
          class="bg-black rounded-2xl p-6 sm:p-8 shadow-xl"
          id="quote-form"
          novalidate
        >
          <input type="hidden" name="form-name" value="quote-request" />

          <!-- Honeypot (hidden from humans, bots fill it in) -->
          <p class="hidden" aria-hidden="true">
            <label>Don't fill this out: <input name="bot-field" /></label>
          </p>

          <h3 class="font-display text-lg font-bold text-white mb-6">Request a Quote</h3>

          <!-- Personal details -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
            <div>
              <label for="full-name" class="block text-sm font-medium text-zinc-200 mb-1">
                Full name <span class="text-red-500" aria-label="required">*</span>
              </label>
              <input
                type="text"
                id="full-name"
                name="full-name"
                required
                autocomplete="name"
                class="w-full border border-zinc-700 rounded-lg px-3 py-2 text-sm text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-colors"
                placeholder="Your name"
              />
            </div>
            <div>
              <label for="phone" class="block text-sm font-medium text-zinc-200 mb-1">
                Phone number <span class="text-red-500" aria-label="required">*</span>
              </label>
              <input
                type="tel"
                id="phone"
                name="phone"
                required
                autocomplete="tel"
                class="w-full border border-zinc-700 rounded-lg px-3 py-2 text-sm text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-colors"
                placeholder="07700 900 000"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
            <div>
              <label for="email" class="block text-sm font-medium text-zinc-200 mb-1">
                Email address <span class="text-zinc-500 font-normal text-xs">(recommended)</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                autocomplete="email"
                class="w-full border border-zinc-700 rounded-lg px-3 py-2 text-sm text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-colors"
                placeholder="you@example.com"
              />
            </div>
            <div>
              <label for="postcode" class="block text-sm font-medium text-zinc-200 mb-1">
                Postcode <span class="text-red-500" aria-label="required">*</span>
              </label>
              <input
                type="text"
                id="postcode"
                name="postcode"
                required
                autocomplete="postal-code"
                class="w-full border border-zinc-700 rounded-lg px-3 py-2 text-sm text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-colors"
                placeholder="ST1 1AA"
              />
            </div>
          </div>

          <!-- Van details -->
          <div class="border-t border-zinc-800 pt-5 mb-4">
            <p class="text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-4">Van Details</p>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4">
              <div>
                <label for="van-make" class="block text-sm font-medium text-zinc-200 mb-1">
                  Van make <span class="text-red-500" aria-label="required">*</span>
                </label>
                <input
                  type="text"
                  id="van-make"
                  name="van-make"
                  required
                  class="w-full border border-zinc-700 rounded-lg px-3 py-2 text-sm text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-colors"
                  placeholder="e.g. Ford"
                />
              </div>
              <div>
                <label for="van-model" class="block text-sm font-medium text-zinc-200 mb-1">
                  Van model <span class="text-red-500" aria-label="required">*</span>
                </label>
                <input
                  type="text"
                  id="van-model"
                  name="van-model"
                  required
                  class="w-full border border-zinc-700 rounded-lg px-3 py-2 text-sm text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-colors"
                  placeholder="e.g. Transit"
                />
              </div>
              <div>
                <label for="van-year" class="block text-sm font-medium text-zinc-200 mb-1">
                  Year <span class="text-zinc-500 font-normal text-xs">(optional)</span>
                </label>
                <input
                  type="text"
                  id="van-year"
                  name="van-year"
                  class="w-full border border-zinc-700 rounded-lg px-3 py-2 text-sm text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-colors"
                  placeholder="e.g. 2021"
                  maxlength="4"
                />
              </div>
            </div>
          </div>

          <!-- Lock requirements -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
            <div>
              <label for="doors" class="block text-sm font-medium text-zinc-200 mb-1">
                Doors to secure <span class="text-red-500" aria-label="required">*</span>
              </label>
              <input
                type="text"
                id="doors"
                name="doors"
                required
                class="w-full border border-zinc-700 rounded-lg px-3 py-2 text-sm text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-colors"
                placeholder="e.g. Both rear doors + offside sliding"
              />
            </div>
            <div>
              <label for="lock-type" class="block text-sm font-medium text-zinc-200 mb-1">
                Lock type <span class="text-red-500" aria-label="required">*</span>
              </label>
              <select
                id="lock-type"
                name="lock-type"
                required
                class="w-full border border-zinc-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-colors bg-black"
              >
                <option value="" disabled selected>Select a lock type</option>
                <option value="deadlock">Deadlock</option>
                <option value="slam-lock">Slam Lock</option>
                <option value="hook-lock">Hook Lock</option>
                <option value="not-sure">Not Sure — please advise</option>
              </select>
            </div>
          </div>

          <!-- Notes -->
          <div class="mb-4">
            <label for="notes" class="block text-sm font-medium text-zinc-200 mb-1">
              Additional notes <span class="text-zinc-500 font-normal text-xs">(optional)</span>
            </label>
            <textarea
              id="notes"
              name="notes"
              rows="3"
              class="w-full border border-zinc-700 rounded-lg px-3 py-2 text-sm text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-colors resize-none"
              placeholder="Anything else I should know? e.g. fleet of vehicles, specific concerns, access restrictions..."
            ></textarea>
          </div>

          <!-- Callback request -->
          <div class="bg-zinc-950 rounded-lg p-4 mb-6">
            <div class="flex items-center gap-3 mb-3">
              <input
                type="checkbox"
                id="request-callback"
                name="request-callback"
                value="yes"
                class="h-4 w-4 text-red-500 border-zinc-700 rounded focus:ring-red-500"
              />
              <label for="request-callback" class="text-sm font-medium text-zinc-200">
                I'd prefer a callback rather than a written quote
              </label>
            </div>
            <div id="callback-time" class="hidden">
              <label for="preferred-time" class="block text-xs font-medium text-zinc-300 mb-1">
                Preferred time
              </label>
              <select
                id="preferred-time"
                name="preferred-time"
                class="border border-zinc-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:ring-2 focus:ring-red-500 bg-black"
              >
                <option value="morning">Morning (8am–12pm)</option>
                <option value="afternoon">Afternoon (12pm–5pm)</option>
                <option value="evening">Evening (5pm–7pm)</option>
              </select>
            </div>
          </div>

          <!-- Submit -->
          <button
            type="submit"
            class="w-full bg-gradient-to-br from-red-600 to-red-700 hover:from-red-500 hover:to-red-600 text-white font-bold text-base py-4 rounded-xl transition-all focus:outline-none focus:ring-2 focus:ring-red-400 shadow-lg shadow-red-600/30 hover:shadow-red-600/50 hover:-translate-y-0.5"
          >
            Send Quote Request
          </button>

          <p class="text-xs text-zinc-500 text-center mt-3">
            I aim to respond the same day. Quotes are valid for 30 days.
            By submitting, you agree to my
            <a href="/privacy" class="underline hover:text-zinc-300 transition-colors">Privacy Policy</a>.
          </p>
        </form>

        <!-- Success message (shown after successful Netlify redirect) -->
        <div id="form-success" class="hidden bg-black rounded-2xl p-8 text-center shadow-xl">
          <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h3 class="font-display text-xl font-bold text-white mb-2">Quote request sent!</h3>
          <p class="text-zinc-300 text-sm leading-relaxed">
            Thanks for getting in touch. I'll be in touch as soon as possible — usually the same day.
            In the meantime, feel free to call or WhatsApp me directly.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    // Toggle callback time picker when checkbox is checked
    var cbCheckbox = document.getElementById('request-callback');
    var cbTime = document.getElementById('callback-time');
    if (cbCheckbox && cbTime) {
      cbCheckbox.addEventListener('change', function () {
        cbTime.classList.toggle('hidden', !cbCheckbox.checked);
      });
    }

    // Show success message if redirected back with ?success=true
    // (Alternative: Netlify can redirect to a /thank-you page instead)
    if (window.location.search.includes('success=true')) {
      var form = document.getElementById('quote-form');
      var success = document.getElementById('form-success');
      if (form) form.classList.add('hidden');
      if (success) success.classList.remove('hidden');
    }
  })();
</script>
