---
import { AREAS, SITE } from '../config/site';
---

<section id="areas" class="bg-zinc-950 scroll-mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-18 lg:py-20">

    <!-- Section heading -->
    <div class="max-w-2xl mb-10">
      <h2 class="font-display text-2xl sm:text-3xl font-extrabold text-white mb-3">
        Areas I Cover
      </h2>
      <p class="text-zinc-300 text-base leading-relaxed">
        I'm based in Stoke-on-Trent and operate across approximately a 20-mile radius.
        I come to you — whether that's your home, workplace, or depot.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-start">

      <!-- Left: Area list -->
      <div>
        <p class="text-sm font-semibold text-zinc-400 uppercase tracking-wider mb-4">
          Examples within my range
        </p>
        <div class="grid grid-cols-2 gap-x-6 gap-y-2 mb-6">
          {AREAS.map((area) => (
            <div class="flex items-center gap-2 text-zinc-200 text-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-red-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              {area}
            </div>
          ))}
        </div>

        <!-- Radius note -->
        <div class="bg-zinc-900 border border-zinc-800 rounded-xl px-5 py-4 mb-6">
          <div class="flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <div>
              <p class="text-sm font-semibold text-red-100 mb-1">Just outside the radius?</p>
              <p class="text-sm text-red-200 leading-relaxed">
                Get in touch anyway — larger jobs and fleet work outside my usual range may
                be considered. I'll always be upfront about whether I can help.
              </p>
            </div>
          </div>
        </div>

        <!-- CTA -->
        <div class="flex flex-col sm:flex-row gap-3">
          <a
            href={SITE.phone.href}
            class="group flex items-center justify-center gap-2 bg-gradient-to-br from-red-600 to-red-700 hover:from-red-500 hover:to-red-600 text-white font-bold text-sm px-5 py-3 rounded-lg transition-all shadow-lg shadow-red-600/30 hover:shadow-red-600/50 hover:-translate-y-0.5"
            aria-label={`Call ${SITE.phone.display}`}
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            Check Availability
          </a>
          <a
            href="#contact"
            class="group flex items-center justify-center gap-2 bg-gradient-to-br from-indigo-600 to-indigo-700 hover:from-indigo-500 hover:to-indigo-600 text-white font-bold text-sm px-5 py-3 rounded-lg transition-all shadow-lg shadow-indigo-600/30 hover:shadow-indigo-600/50 hover:-translate-y-0.5"
          >
            Request a Quote
          </a>
        </div>
      </div>

      <!-- Right: Map placeholder -->
      <div>
        <div class="bg-zinc-800 rounded-xl flex flex-col items-center justify-center aspect-[4/3] text-zinc-500 border border-zinc-700 relative overflow-hidden">
          <!-- Placeholder visual -->
          <div class="absolute inset-0 flex items-center justify-center">
            <!-- Concentric circles representing the coverage radius -->
            <div class="absolute w-72 h-72 rounded-full border-2 border-red-500/20"></div>
            <div class="absolute w-48 h-48 rounded-full border-2 border-red-500/40"></div>
            <div class="absolute w-24 h-24 rounded-full border-2 border-red-500/60"></div>
          </div>
          <div class="relative z-10 text-center px-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-red-500 mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <p class="text-zinc-200 font-semibold text-sm mb-1">Stoke-on-Trent</p>
            <p class="text-zinc-400 text-xs">~20-mile service radius</p>
            <p class="text-zinc-500 text-xs mt-3 italic">
              Map coming soon
              <!-- TODO: Replace with an OpenStreetMap embed or static map image -->
            </p>
          </div>
        </div>
        <p class="text-xs text-zinc-500 mt-3 text-center">
          Service area is approximate. Contact me to confirm I cover your postcode.
        </p>
      </div>

    </div>
  </div>
</section>
