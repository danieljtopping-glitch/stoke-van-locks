---
// Gallery section — placeholder until real photos are provided.
// To add real photos:
// 1. Place .jpg or .webp files in /public/images/
// 2. Replace the placeholder array below with real image data
// 3. Use Astro's <Image /> component from 'astro:assets' for optimised output

const images = [
  { src: '/images/gallery-new-1.jpg', alt: 'Black statement lock on grey van door' },
  { src: '/images/gallery-new-2.jpg', alt: 'Internal deadlock view' },
  { src: '/images/gallery-new-3.jpg', alt: 'Chrome slam lock on red van' },
  { src: '/images/gallery-new-4.png', alt: 'L4V statement lock plate' },
  { src: '/images/gallery-new-5.jpg', alt: 'Black deadlock on grey van door' },
  { src: '/images/gallery-new-6.jpg', alt: 'Chrome deadlock next to black van door handle' },
];
---

<section id="gallery" class="bg-black scroll-mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-18 lg:py-20">

    <!-- Section heading -->
    <div class="max-w-2xl mb-10">
      <h2 class="font-display text-2xl sm:text-3xl font-extrabold text-white mb-3">
        My Work
      </h2>
      <p class="text-zinc-300 text-base leading-relaxed">
        Every installation is carried out to a high standard — clean, precise, and built to last.
        Here are a few examples of security products that I can supply and fit to your vehicle/s.
      </p>
    </div>

    <!-- Image grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {images.map((item) => (
        <div class="group relative bg-zinc-900 rounded-xl overflow-hidden aspect-[4/3] flex flex-col items-center justify-center border border-zinc-800 hover:border-red-500 transition-colors shadow-lg">
          <img 
            src={item.src} 
            alt={item.alt} 
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
            loading="lazy" 
          />
        </div>
      ))}
    </div>

    <!-- Ask for examples CTA -->
    <p class="text-center text-zinc-400 text-sm mt-10">
      Want to see more examples or specific lock types?
      <a href="#contact" class="text-red-500 hover:text-red-500 font-semibold transition-colors underline underline-offset-2">
        Get in touch today.
      </a>
    </p>

  </div>
</section>
