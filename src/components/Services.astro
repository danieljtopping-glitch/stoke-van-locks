---
import { SERVICES } from '../config/site';

// Map service icons to SVG paths
const iconPaths: Record<string, string> = {
  deadlock: 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z',
  slam: 'M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z',
  hook: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  repair: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z',
  upgrade: 'M13 10V3L4 14h7v7l9-11h-7z',
};
---

<section id="services" class="bg-black scroll-mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-18 lg:py-20">

    <!-- Section heading -->
    <div class="max-w-2xl mb-12">
      <h2 class="font-display text-2xl sm:text-3xl font-extrabold text-white mb-3">
        Van Security Services
      </h2>
      <p class="text-zinc-300 text-base leading-relaxed">
        I supply and fit a full range of van security locks - from everyday deadlocks
        to high-security hook locks. Not sure what you need? Just ask - I'm happy to advise.
      </p>
    </div>

    <!-- Services grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-10">
      {SERVICES.map((service) => (
        <div class="group bg-black border border-zinc-800 rounded-xl p-6 hover:border-red-500 hover:shadow-lg transition-all">
          <!-- Icon -->
          <div class="w-12 h-12 bg-navy-800 group-hover:bg-red-600 rounded-lg flex items-center justify-center mb-4 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-red-500 group-hover:text-navy-900 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths[service.icon]} />
            </svg>
          </div>

          <!-- Title -->
          <h3 class="font-display font-bold text-white text-lg mb-2">{service.title}</h3>

          <!-- Description -->
          <p class="text-zinc-300 text-sm leading-relaxed mb-4">{service.description}</p>

          <!-- Details list -->
          <ul class="space-y-1.5 mb-5">
            {service.details.map((detail) => (
              <li class="flex items-start gap-2 text-sm text-zinc-300">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-red-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                {detail}
              </li>
            ))}
          </ul>

          <!-- Who it's for -->
          <p class="text-xs text-zinc-500 mb-4 italic">
            Ideal for: {service.whoFor}
          </p>

          <!-- CTA -->
          <a
            href="#contact"
            class="group inline-flex items-center gap-1 text-sm font-semibold text-indigo-400 hover:text-indigo-300 transition-colors"
            aria-label={`Get a quote for ${service.title}`}
          >
            Get a Quote
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      ))}
    </div>

    <!-- Emergency lockout note -->
    <div class="bg-zinc-950 border border-zinc-800 rounded-xl px-6 py-5 flex items-start gap-4">
      <div class="shrink-0 mt-0.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <div>
        <p class="font-semibold text-white text-sm mb-1">A note on emergency lockouts</p>
        <p class="text-zinc-300 text-sm leading-relaxed">
          I don't offer a general emergency lockout service. However, if you're locked out of your
          van because of a lock I fitted, please call me and I'll do my best to help as quickly as I can.
          For all other lockout situations, I'd recommend contacting a local auto locksmith.
        </p>
      </div>
    </div>

  </div>
</section>
